<!DOCTYPE html>
<html class="no-js" lang="{{ locale }}" dir="ltr">

	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{% if title %}{{ title }}{% else %}{% if locale === "fr" %}La page{% else %}Page{% endif %}{% endif %}{% if locale === "en" %} has been moved{% else %} a été déplacée{% endif %} - {{ settings[locale].metaTitle }}</title>

		<meta http-equiv="refresh" content="0; URL={{ redirect }}" />

		<!-- GC Design System CSS Shortcuts -->
		<link
		  rel="stylesheet"
		  href="{{ pathPrefix }}/css/gcds-css-shortcuts.min.css"
		/>

		<!-- GC Design System -->
		<link
		  rel="stylesheet"
		  href="{{ pathPrefix }}/gcds/gcds.css"
		/>
		<script
		  type="module"
		  src="{{ pathPrefix }}/gcds/gcds.esm.js"
		></script>
	</head>

	<body>
		<main style="padding: 2rem;">
			{% if title %}
			<h1 class="mt-0 mb-300">{{ title }}</h1>
			{% endif %}
		{% if locale === "en" %}

		<p>This page has moved to a <a href="{{ redirect }}">new location</a>.</p>

		{% else  %}

		<p>Cette page a été déplacée vers un <a href="{{ redirect }}">nouvel emplacement</a>.</p>

		{% endif %}
		</main>
	</body>

</html>
