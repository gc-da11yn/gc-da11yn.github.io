{% set otherLang = "fr" if locale == "en" else
	"en" %}
<head>
	<meta charset="utf-8">

	<!-- Web Experience Toolkit (WET) / Boîte à outils de l'expérience Web (BOEW)
		wet-boew.github.io/wet-boew/License-en.html / wet-boew.github.io/wet-boew/Licence-fr.html -->
	{% set metaTitle = settings[locale].metaTitle %}
	<title>
		{%- if settings.env == "dev" -%}
			{%- if locale != "fr" -%}
				In development -
			{%- else -%}
				En cours de développement -
			{%- endif -%}
		{%- endif -%}
		{%- if archived -%}
			{{ archiveStrings[locale].archivedTitle }}
		{%- endif -%}
		{{ title | striptags(true) | escape | nl2br }}
		{%- if tags !="home" -%}
			- {{ metaTitle }}
		 {%- endif -%}
	</title>
	<meta content="width=device-width,initial-scale=1" name="viewport">
	<meta name="description" content="{{ description | striptags(true) | escape | nl2br }}">

	{% if settings.env == "dev" %}
	<meta name="robots" content="noindex, nofollow">
	{% endif %}

	<meta name="source-file" content="{{ page.inputPath }}">


	{% if needsTranslation != true and toggle %}
	{% set otherLangSlug = toggle | stripTagsSlugify %}
	{# Special handling for home pages #}
	{% if tags and 'home' in tags %}
		{% set toggleUrl = pathPrefix + "/" + otherLang + "/" %}
	{% else %}
		{% set toggleUrl = pathPrefix + "/" + otherLang + "/" + otherLangSlug + "/" %}
	{% endif %}
		<link rel="alternate" hreflang="{{ otherLang }}" href="{{ toggleUrl }}index.html" />
	{% endif %}


	<link href="https://www.canada.ca/etc/designs/canada/wet-boew/assets/favicon.ico" rel="icon" type="image/x-icon">
	<link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.8.1/css/all.css" integrity="sha384-50oBUHEmvpQ+1lW4y57PTFmhCaXp0ML5d60M1M7uH2+nqUivzIebhndOJK28anvf" crossorigin="anonymous"/>
	{#- TRANSITION-ONLY: WET runtime only on pages with "wetboewRuntime: true" in front matter, until their behaviour is migrated. -#}
	{% if wetboewRuntime %}
	<link rel="stylesheet" href="https://www.canada.ca/etc/designs/canada/wet-boew/css/theme.min.css"/>
	{% endif %}

	<!-- GC Design System CSS Shortcuts -->
	<link
	  rel="stylesheet"
	  href="{{ pathPrefix }}/css/gcds-css-shortcuts.min.css"
	/>

	<!-- GC Design System -->
    <link
      rel="stylesheet"
      href="{{ pathPrefix }}/gcds/gcds.css"
    />

	<!-- Site styles: after GCDS so they can build on it -->
	<link rel="stylesheet" href="{{ pathPrefix }}/css/da11yn.css">
    {#- Basic HTML version: "?wbdisable=true" skips the GCDS scripts (same parameter as WET), "?wbdisable=false" turns them back on. -#}
    <script>
      (function () {
        var key = "basicHtml";
        var match = location.search.match(/[?&]wbdisable=(true|false)/);
        var basic = !!match && match[1] === "true";
        try {
          if (match) {
            if (basic) { localStorage.setItem(key, "1"); } else { localStorage.removeItem(key); }
          }
          basic = localStorage.getItem(key) === "1";
        } catch (e) {}
        document.documentElement.classList.add(basic ? "basic-html" : "standard-html");
        if (!basic) {
          var gcds = document.createElement("script");
          gcds.type = "module";
          gcds.src = "{{ pathPrefix }}/gcds/gcds.esm.js";
          document.head.appendChild(gcds);
        }
      })();
    </script>

	<!-- Meta tags -->

	<meta name="author" content="{{ header[locale].governmentOfCanada }}" />
	<meta name="dcterms.title" content="
	{%- if archived -%}
		{{ archiveStrings[locale].archivedTitle }}
	{%- endif -%}
	{{ title | striptags(true) | escape | nl2br }}" />
	<meta name="dcterms.description" content="{{  description }}" />
	<meta name="dcterms.creator" content="{{ header[locale].governmentOfCanada }}">
	<meta name="dcterms.language" content="{{ locale }}" />
	<meta name="dcterms.created" content="{{ settings.dateCreated }}">
	<meta name="dcterms.modified" content="{{ page.date | postDate }}" >
	<meta name="dcterms.subject" content="{% if subject %}{{ tagList.subjects[locale][subject] }};{% endif %}{% for item in tags %}{{ tagList.tags[locale][item] }}; {% endfor %}" />

	<!-- Google tag (gtag.js) -->
	<script async src="https://www.googletagmanager.com/gtag/js?id=G-SM9MSHWDVN"></script>
	<script>
		(function (w) {
			"use strict";
			if (w.location.hostname === "a11y.canada.ca") {
				w.dataLayer = w.dataLayer || [];
				w.gtag = function () {
					w.dataLayer.push(arguments);
				};
				w.gtag('js', new Date());
				w.gtag('config', 'G-SM9MSHWDVN');
			}
		})(window);
	</script>
</head>
