<nav class="gcds-role-nav" aria-labelledby="gcds-role-nav-heading">
	<h2 id="gcds-role-nav-heading">{{ onThisPage[locale].heading }}</h2>
	<ul>
		{% for group in gcdsRoleGroups %}
		{% set label = group[1] %}
		{% set anchor = label | stripTagsSlugify %}
		{% set groupRoleKeys = group[0] | roleKeysForGroup(roles) %}
		{% set sourceItems = gcdsRoleItems or collections.rolePages %}
		{% set items = sourceItems
		| byAnyRole(groupRoleKeys)
		| localeMatch(locale) %}
		<li>
			<a href="#{{ anchor }}">{{ label }}</a>
			{% if items.length %}<span>({{ items.length }})</span>{% endif %}
		</li>
		{% endfor %}
	</ul>
</nav>
