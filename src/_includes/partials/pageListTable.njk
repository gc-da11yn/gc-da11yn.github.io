{% set branch = "main" %}
{% from "macros/contentType.njk" import getContentType %}

	{#- TRANSITION-ONLY: WET overlay link, until GCDS has a dialog. -#}
	<a href="#full-screen" aria-controls="full-screen" class="overlay-lnk btn btn-primary btn-block mb-200" role="button">{{ pageList[locale].definitionButtonText }}</a>

	<!-- CSV Download Button -->
	<p class="mb-300">
		<a class="button-link" href="{{ pathPrefix }}/docs/pages-{{ locale }}.csv" download="pages-{{ locale }}.csv">
			<gcds-icon name="download"></gcds-icon>
			{% if locale === "en" %}Download CSV Export{% else %}Télécharger l'export CSV{% endif %}
		</a>
	</p>

	<section id="full-screen" class="wb-overlay modal-content overlay-def wb-popup-full">
		<header class="modal-header">
			<h2>{{ pageList[locale].definitionButtonText }}</h2>
		</header>
		<div class="row modal-body">
			<section class="col-md-4">
				<h3>{{ pageList[locale].subjectsText }}</h3>
				{% for item, tag in tagList.subjects[locale] %}
				<dl>
					<dt><span class="label label-success">{{ item }}</span></dt>
					<dd>{{ tag }}</dd>
				</dl>
				{% endfor %}
			</section>
			<section class="col-md-4">
				<h3>{{ pageList[locale].tagsText }}</h3>
				{% for item, tag in tagList.tags[locale] %}
				<dl>
					<dt><span class="label label-info">{{ item }}</span></dt>
					<dd>{{ tag }}</dd>
				</dl>
				{% endfor %}
			</section>
			<section class="col-md-4">
				<h3>{% if locale === "en" %}Roles{% else %}Rôles{% endif %}</h3>
				{% if roles and roles.labels and roles.labels[locale] %}
				{% for roleKey, roleLabel in roles.labels[locale] %}
				<dl>
					<dt><span class="label label-warning">{{ roleKey }}</span></dt>
					<dd>{{ roleLabel }}</dd>
				</dl>
				{% endfor %}
				{% endif %}
			</section>
		</div>
	</section>

{#- gcds-table handles keyword filter, sorting and pagination; page-list-table.js applies the checkboxes. -#}
	{% set en = locale === "en" %}
	{% set columns = [
		{ field: "title", header: ("Title" if en else "Titre"), slotted: true, sort: true, rowHeader: true },
		{ field: "tags", slotted: true, header: pageList[locale].tagsText, sort: true },
		{ field: "subject", slotted: true, header: pageList[locale].subjectsText, sort: true },
		{ field: "role", slotted: true, header: ("Role" if en else "Rôle"), sort: true },
		{ field: "layout", header: ("Layout" if en else "Mise en page"), sort: true },
		{ field: "modified", slotted: true, header: ("Date Modified" if en else "Date de modification"), sort: true },
		{ field: "created", slotted: true, header: ("Date Created" if en else "Date de création"), sort: true },
		{ field: "type", header: ("Content Type" if en else "Type de contenu"), sort: true },
		{ field: "file", header: ("Link to file" if en else "Lien vers le fichier"), slotted: true }
	] %}

	{% set columnOptions = [] %}
	{% for column in columns %}
		{% set columnOptions = (columnOptions.push({ id: "column-" + column.field, label: column.header, value: column.field, checked: true }), columnOptions) %}
	{% endfor %}
	{% set columnOptions = (columnOptions.push(
		{ id: "column-isLanding", label: ("Is a landing page?" if en else "Une page d'atterrissage ?"), value: "isLanding", checked: true },
		{ id: "column-isPage", label: ("Is a content page?" if en else "Une page de contenu ?"), value: "isPage", checked: true }
	), columnOptions) %}

	{% set rows = [] %}
	{% for entry in entries | sort(false, false, 'data.title') %}
		{% if entry.data.locale == locale and not entry.data.redirect and not entry.inputPath.endsWith('.csv.njk') %}
			{% set newPath = entry.inputPath | replace("\./", "/") %}
			{% set contentType %}{{ getContentType(entry.inputPath, locale) }}{% endset %}
			{% if not entry.data.role %}{% set roleList = [] %}{% elif entry.data.role is string %}{% set roleList = [entry.data.role] %}{% else %}{% set roleList = entry.data.role %}{% endif %}
			{% set rows = (rows.push({
				title: entry.data.title | striptags(true),
				url: entry.url,
				tags: (entry.data.tags | join(", ")) if entry.data.tags else "",
				subject: entry.data.subject or "",
				role: roleList | join(", "),
				layout: entry.data.layout or "",
				modified: (entry.date | postDate) if entry.date else "",
				created: (entry.data.gitCreated | postDate) if entry.data.gitCreated else "",
				type: contentType | trim,
				file: newPath,
				fileUrl: "https://github.com/gc-da11yn/gc-da11yn.github.io/tree/" + branch + newPath,
				pageType: "isLanding" if "/main/" in entry.inputPath else "isPage"
			}), rows) %}
		{% endif %}
	{% endfor %}

	{#- Single-option gcds-checkboxes in a native fieldset so the options can sit in columns. -#}
	<fieldset id="page-list-table-columns" class="page-list-fieldset mb-300">
		<legend>{{ pageList[locale].columnsLegend }}</legend>
		<gcds-grid columns="1fr 1fr" columns-tablet="repeat(3, 1fr)" columns-desktop="repeat(4, 1fr)" gap="150">
			{% for option in columnOptions %}
			<gcds-checkboxes name="page-list-table-columns" options="{{ [option] | dump | escape }}"></gcds-checkboxes>
			{% endfor %}
		</gcds-grid>
	</fieldset>

	<gcds-table
		id="page-list-table"
		filter
		sort
		pagination
		pagination-size="25"
		columns="{{ columns | dump | escape }}"
		data="{{ rows | dump | escape }}"
	>
		<span slot="caption">{{ pageList[locale].tableCaption }}</span>
		<template slot="cell:title"><gcds-link data-bind-template-href="{url}" data-bind="title"></gcds-link></template>
		<template slot="cell:tags"><page-list-tags variant="tag" data-bind-tags="tags" class="d-flex flex-wrap gap-50"></page-list-tags></template>
		<template slot="cell:subject"><page-list-tags variant="subject" data-bind-tags="subject" class="d-flex flex-wrap gap-50"></page-list-tags></template>
		<template slot="cell:role"><page-list-tags variant="role" data-bind-tags="role" class="d-flex flex-wrap gap-50"></page-list-tags></template>
		<template slot="cell:modified"><span class="page-list-date" data-bind="modified"></span></template>
		<template slot="cell:created"><span class="page-list-date" data-bind="created"></span></template>
		<template slot="cell:file"><gcds-link data-bind-template-href="{fileUrl}" data-bind="file"></gcds-link></template>
	</gcds-table>

	<noscript><p>{{ pageList[locale].noScriptText }}</p></noscript>

<script src="{{ pathPrefix }}/js/page-list-table.js" defer></script>
