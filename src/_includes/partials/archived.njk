{#- Archived page notice (replaces the WET in-view and sticky archive banners) -#}
<gcds-container layout="page" padding="300">
	<gcds-notice notice-role="warning" notice-title-tag="h2" notice-title="{{ archiveStrings[locale].archivedHeading }}">
		<p class="mb-0">{{ archiveStrings[locale].archivedPara | safe }}</p>
	</gcds-notice>
</gcds-container>
