{% if redirect %}
{% include "partials/redirect.njk" %}
{% else %}

<!DOCTYPE html>
<html class="no-js" lang="{{ locale }}" dir="ltr">

	{% include "partials/head.njk" %}

	<body vocab="http://schema.org/" typeof="WebPage">

		{#- Only shown in basic HTML mode (see head.njk), so nobody gets stuck in it -#}
		<p class="basic-html-notice bg-light p-200 m-0 text-center">{{ skipnav[locale].basicNotice }} <a href="?wbdisable=false">{{ skipnav[locale].standardVersion }}</a></p>

		{% include "partials/header.njk" %}

		<main property="mainContentOfPage" resource="#wb-main" typeof="WebPageElement" id="main">

		{% block content %}
			<gcds-container layout="full" class="banner">
			  <gcds-container layout="page" padding="200">
				<gcds-grid columns="1fr" columns-desktop="4fr 1fr" class="py-150">
				  <div class="banner__box">
					<h1 class="mt-0 mb-300 text-light" property="name">
						{%- if archived -%}
							{{ archiveStrings[locale].archivedTitle }}
						{%- endif -%}
						{{ title | safe }}
					</h1>
					{% if description %}
					<p>{{ description | safe }}</p>
					{% else %}
					<p><strong>{{ landingPage[locale].descriptionNoneText }}</strong></p>
					{% endif %}
					{%- if role -%}
					<hr />
					<h2 class="font-size-h6">Related roles:</h2>
					<ul class="list-none ps-0 d-flex flex-wrap gap-100">
						{% for key in role %}
						<li class="dev-tag dev-tag--subject d-inline-block px-100 bs-lg font-bold">
							{{ roles.labels[locale][key] or key }}
						</li>
						{% endfor %}
					</ul>
					{%- endif -%}
				  </div>
				</gcds-grid>
			  </gcds-container>
			</gcds-container>

			{%- if archived -%}
			{%- include "partials/archived.njk" -%}
			{%- endif %}

			{% include "partials/alerts.njk" %}

			{#- "fullWidth: true" in front matter lets wide content (e.g. the page list table) use the full width. -#}
			{% if fullWidth %}<gcds-container layout="full" class="px-300 pb-300">{% else %}<gcds-container layout="page" padding="300">{% endif %}
				{% if officeTOC === true %}
				{% include "partials/office-toc.njk" %}
				{% include "partials/office365Notice.njk" %}
				{% endif %}

				{% if hasDocument %}
				{% include "partials/download.njk" %}
				{% endif %}

				{% if toc or tocSimple %}
				{% include "partials/onThisPage.njk" %}
				{% endif %}

				<div class="page-content">
				{{ content | safe }}
				</div>
				{% if officeTOC === true %}
				{% include "partials/office-toc.njk" %}
				{% endif %}
			</gcds-container>

			{% include "partials/pagedetails.njk" %}

		{% endblock %}
		</main>

		{% include "partials/contribute.njk" %}

		{% include "partials/footer.njk" %}

		<script src="https://ajax.googleapis.com/ajax/libs/jquery/2.2.4/jquery.js"></script>
		{#- TRANSITION-ONLY: WET runtime only on pages with "wetboewRuntime: true" in front matter, until their behaviour is migrated. -#}
		{% if wetboewRuntime %}
		<script src="https://www.canada.ca/etc/designs/canada/wet-boew/js/wet-boew.min.js"></script>
		<script src="https://www.canada.ca/etc/designs/canada/wet-boew/js/theme.min.js"></script>
		{% endif %}

		{%- if js === "chart" -%}

		<script>
			window["wb-charts"] = {
				plugins: ["https://gitcdn.link/repo/winne27/flot-valuelabels/master/jquery.flot.valuelabels.min.js"]
			};
		</script>

		<script src="{{ pathPrefix }}js/chart.js"></script>

		{%- endif -%}

		{%- if settings.env == "dev" or settings.env == "local" -%}
			{% include "partials/sa11y.njk" %}
		{%- endif -%}
	</body>

</html>

{% endif %}
