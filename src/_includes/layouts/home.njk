{% if redirect %}
	{% include "partials/redirect.njk" %}
{% else %}

{% extends "layouts/base.njk" %}

{% block content %}

<gcds-container layout="full" class="banner">
  <gcds-container layout="page" padding="200">
    <gcds-grid columns="1fr" columns-desktop="4fr 1fr" class="py-250">
      <div class="banner__box">
        <h1 class="mt-0 mb-200 text-light" property="name">
          {{ title | safe }}
        </h1>
        <p>{{ description | safe }}</p>
      </div>
    </gcds-grid>
  </gcds-container>
</gcds-container>

{% include "partials/alerts.njk" %}

<gcds-container tag="section" layout="page" padding="300">
	<h2 class="mt-0 mb-300">{{ home[locale].explore }}</h2>
	<div class="page-content">
	{{ content | safe }}
	</div>
	{% include "partials/collectionsMain.njk" %}
</gcds-container>

{% include "partials/updatesMain.njk" %}
{% include "partials/about.njk" %}
{% include "partials/pagedetails.njk" %}

{% endblock %}

{% endif %}
